{
  "id": "root",
  "type": "row",
  "titlebar": "none",
  "traffic_lights": [
    12,
    16
  ],
  "background": "canvas",
  "terminal_padding": [
    14,
    12
  ],
  "children": [
    {
      "id": "sidebar",
      "type": "column",
      "size": {
        "px": 268
      },
      "min": 44,
      "max": 480,
      "resizable": false,
      "children": [
        {
          "id": "brand",
          "type": "block",
          "size": {
            "px": 46
          },
          "window_drag": true,
          "content": {
            "mod": "seamless-chrome"
          }
        },
        {
          "id": "sidebar-lists",
          "type": "column",
          "children": [
            {
              "id": "spaces",
              "type": "block",
              "size": {
                "weight": 1
              },
              "min": 90,
              "content": {
                "mod": "seamless-spaces"
              }
            },
            {
              "id": "agents",
              "type": "block",
              "size": {
                "weight": 1
              },
              "min": 90,
              "content": {
                "mod": "seamless-agents"
              }
            }
          ]
        },
        {
          "id": "sidebar-footer",
          "type": "block",
          "size": {
            "px": 69
          },
          "content": {
            "mod": "seamless-chrome",
            "props": {
              "footer": true
            }
          }
        }
      ],
      "background": "chrome"
    },
    {
      "id": "work",
      "type": "column",
      "resizable": false,
      "children": [
        {
          "id": "tabs",
          "type": "block",
          "size": {
            "px": 34
          },
          "window_drag": true,
          "content": {
            "mod": "seamless-tabs"
          }
        },
        {
          "id": "work-body",
          "type": "row",
          "padding": [
            3,
            8
          ],
          "gap": 8,
          "children": [
            {
              "id": "main",
              "type": "block",
              "content": {
                "tab": "active",
                "pane": {
                  "gap": 8,
                  "radius": 16,
                  "background": "background",
                  "lone": true,
                  "border": {
                    "width": 3,
                    "color": "#00000018"
                  },
                  "focus": {
                    "width": 3,
                    "color": "#ff4fa3"
                  },
                  "header": {
                    "content": {
                      "mod": "seamless-pane"
                    },
                    "height": 30,
                    "position": "top",
                    "reveal": "always"
                  }
                }
              }
            },
            {
              "id": "panel",
              "type": "column",
              "hidden": true,
              "size": {
                "px": 338
              },
              "min": 280,
              "max": 900,
              "children": [
                {
                  "id": "panel-body",
                  "type": "stack",
                  "active": "files",
                  "children": [
                    {
                      "id": "files",
                      "type": "block",
                      "content": {
                        "mod": "files"
                      }
                    },
                    {
                      "id": "changes",
                      "type": "block",
                      "content": {
                        "mod": "changes"
                      }
                    }
                  ]
                }
              ]
            }
          ],
          "background": "canvas"
        }
      ],
      "background": "chrome"
    }
  ],
  "terminal_opacity": 0,
  "theme": {
    "light": "cozy-paper",
    "dark": "graphite"
  }
}